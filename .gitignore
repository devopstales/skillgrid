.DS_Store
# Local vendor clone for syncing upstream agent-skills (not committed)
.vendor/
__pycache__

node_modules
.venv/
.qwen/settings.json.orig
!install.sh
install*.sh*
!install.sh

# Hugo build artifacts
site/.hugo_build.lock

# skillgrid-cli build artifacts (Taskfile at repo root builds into dist/)
/dist/
skillgrid-cli/dist/
skillgrid-cli/skillgrid
skillgrid-cli/bin/
skillgrid-cli/out/

# Generated skill registry cache (regenerated by skill-registry refresh)
.atl/
.gitworktree/
.worktrees/
# .skillgrid: change-specs/ (active) + change-archive/ (closed) are committed;
# meta/ holds machine state (.sdd/ and .cache/ are gitignored).
.skillgrid/meta/.sdd/
.skillgrid/.cleave/
 .skillgrid/brainstorm/
.skillgrid/meta/.cache/
# okf-lint.mjs telemetry sink (repocodex metrics.jsonl pattern); operational
# artifact, not memory. Repo-root-scoped: the guard itself runs on fixtures,
# so its default sink lands under <fixture>/.skillgrid/ on manual runs.
/.skillgrid/meta/okf-metrics.jsonl

