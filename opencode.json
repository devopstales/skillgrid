{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "context-mode",
    "background-agents",
    "engram"
  ],
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "mcp": {
    "context7-http": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "deepwiki-http": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "exa-http": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "ccc": {
      "type": "local",
      "command": [
        "ccc",
        "mcp"
      ],
      "enabled": true
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "gitnexus@1.3.11",
        "mcp"
      ],
      "enabled": true
    },
    "trivy": {
      "type": "local",
      "command": [
        "trivy",
        "mcp"
      ],
      "enabled": true
    }
  },
  "instructions": [
    ".agents/rules/*.mdc",
    "AGENTS.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    }
  }
}
