{
  "name": "skill-pi",
  "version": "0.0.0",
  "private": true,
  "description": "Skillgrid on pi: an opinionated distribution of pi (by Mario Zechner) with extensions for memory, code intelligence, and skillgrid session lifecycle.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "skill-pi",
    "skillgrid",
    "coding-agent",
    "agent-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillgrid/skillgrid-v2.git"
  },
  "bin": {
    "skill-pi": "./bin/skill-pi.js"
  },
  "main": "index.js",
  "files": [
    "bin/",
    "lib/",
    "extensions/",
    "index.js",
    "pi-version.txt",
    "mcp.json",
    "settings.json",
    "system/",
    "themes/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "piConfig": {
    "name": "skill-pi",
    "configDir": ".skill-pi"
  },
  "pi": {
    "extensions": ["./extensions/splash.js", "./extensions/tokyo-night-footer.ts"],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0"
  }
}
