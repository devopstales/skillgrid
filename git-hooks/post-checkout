#!/bin/sh
# post-checkout — taskwright warn + reindex after a branch switch. Fail-open.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

# 1. taskwright post-checkout warn (only on branch checkout, $3 == 1)
if [ "${3:-0}" -eq 1 ] && [ -f ".taskwright/hooks/worktree-warn.js" ]; then
    node ".taskwright/hooks/worktree-warn.js" || true
fi

# 2. mnemonic reindex (skipped for large diffs > 20 files)
count=$(git diff --name-only HEAD~1..HEAD 2>/dev/null | wc -l | tr -d ' ')
[ "$count" -gt 20 ] && exit 0
command -v mnemonic >/dev/null 2>&1 || exit 0
mnemonic index --dir "$root" >/dev/null 2>&1 || true
mnemonic pages --dir "$root" >/dev/null 2>&1 || true
exit 0
