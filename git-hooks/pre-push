#!/bin/sh
# pre-push — validate Refs/Closes footers on outgoing commits. Blocks only on
# malformed Closes/Fixes/Resolves (explicit close intent with no Tracker ID);
# fail-open on infra errors (the implementation exits 0 when ticketing is
# disabled or git gives it nothing to check). Ref lines arrive on stdin and
# pass through untouched.
HOOK_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
command -v node >/dev/null 2>&1 || exit 0
node "$HOOK_DIR/../hooks/checkpoint-state.js" pre-push "$@"
rc=$?
exit $rc
