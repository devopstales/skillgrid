+// ctx config, 8787), -bin (agent binary, default: the agent name),
+// -dir (repository directory for ctx config resolution). Remaining
+// positional args are passed through to the agent.
+func runCtxWrap(args []string) {
+	fs := flag.NewFlagSet("ctx wrap", flag.ContinueOnError)
+	fs.SetOutput(os.Stderr)
+	bind := fs.String("bind", "", "proxy bind address (default from ctx config, 127.0.0.1)")
+	port := fs.Int("port", 0, "proxy port (default from ctx config, 8787)")
+	bin := fs.String("bin", "", "agent binary to launch (default: the agent name)")
+	dir := fs.String("dir", ".", "repository directory (for ctx config resolution)")
+	if err := fs.Parse(args); err != nil {
+		os.Exit(2)
+	}
+	pos := fs.Args()
+	if len(pos) == 0 {
+		fmt.Fprintln(os.Stderr, "usage: mnemonic ctx wrap <agent> [agent args...] [-bind <addr>] [-port <n>] [-bin <path>] [-dir <dir>]")
+		os.Exit(2)
+	}
+	agentName := pos[0]
+	agentArgs := pos[1:]
+
+	// Load the ctx config (config.d precedence: defaults -> machine -> repo).
+	cfg, err := ctxconfig.Load(context.Background(), *dir)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error: loading ctx config: %v\n", err)
+		os.Exit(1)
+	}
+
+	// Resolve bind/port from flags or config.
+	b := *bind
+	if b == "" {
+		b = cfg.Proxy.Bind
+	}
+	p := *port
+
+	log := slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo}))
+
+	res, stopProxy, err := ctxwrap.Wrap(ctxwrap.Options{
+		Cfg:       cfg,
+		AgentName: agentName,
+		Binary:    *bin,
+		Args:      agentArgs,
+		Env:       os.Environ(),
+		Port:      p,
+		Bind:      b,
+		Log:       log,
+	}, ctxwrap.DefaultStartProxy)
+	if err != nil {
+		// Fail-open (ADR-0016): clear error, non-zero exit, no panic.
+		// Agent resolution, proxy start, and launch failures all land here.
+		fmt.Fprintf(os.Stderr, "error: %v\n", err)
+		os.Exit(1)
+	}
+	if res.BackupPath != "" {
+		log.Info("backup written", "agent", agentName, "path", res.BackupPath)
+	} else if !res.Injected {
+		log.Info("already wrapped, skipping inject+backup", "agent", agentName)
+	}
+	log.Info("agent launched", "agent", agentName, "proxy", res.ProxyBaseURL, "port", res.Port)
+
+	// Keep the proxy alive for the subprocess lifetime: SIGINT/SIGTERM on
+	// the CLI stops the proxy (and the process, via the default signal
+	// disposition after stopProxy), the agent exiting stops the proxy, and
+	// we exit with the agent's exit code.
+	ctx, stopSignals := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
+	defer stopSignals()
+	go func() {
+		<-ctx.Done()
+		stopProxy()
+	}()
+
+	if err := res.Command.Wait(); err != nil {
+		stopProxy()
+		if ee, ok := err.(*exec.ExitError); ok {
+			os.Exit(ee.ExitCode())
+		}
+		fmt.Fprintf(os.Stderr, "error: agent exited: %v\n", err)
+		os.Exit(1)
+	}
+	stopProxy()
+}
diff --git a/mnemonic/internal/ctx/wrap/agents.go b/mnemonic/internal/ctx/wrap/agents.go
new file mode 100644
index 00000000..73c9a24d
--- /dev/null
+++ b/mnemonic/internal/ctx/wrap/agents.go
@@ -0,0 +1,83 @@
+// Package wrap implements `ctx wrap <agent>` (T07, plan 16.8/16.10): the
+// tier-2 launcher that starts the loopback proxy, injects the agent's
+// config to point at the proxy, backs up the previous config before
+// writing, and launches the agent as a subprocess. The agent's code is
+// never modified — only its config (env). Re-running is idempotent.
+//
+// The launcher is the only component that knows about specific agents
+// (config.Wrap.Agents lists what is enabled; the agent table in agents.go
+// maps names to providers and env vars).
+package wrap
+
+import "fmt"
+
+// provider is the wire protocol family an agent speaks to the proxy. The
+// proxy itself (T04) speaks both; the provider only selects the base-URL
+// env var the launched subprocess gets (plan 16.8 Tier 1 contract).
+type provider string
+
+const (
+	providerAnthropic provider = "anthropic"
+	providerOpenAI    provider = "openai"
+)
+
+// Agent describes one wrappable agent: its canonical name, the provider it
+// speaks, and the base-URL env var that must point at the proxy.
+type Agent struct {
+	Name     string
+	Provider provider
+	EnvVar   string
+}
+
+// agentTable is the launcher's agent → config mapping (T07: keep it a small
+// table; the exact per-agent detail can grow here later). Claude is the
+// Anthropic-compatible agent; codex/cursor/opencode/aider are OpenAI-
+// compatible.
+var agentTable = []Agent{
+	{Name: "claude", Provider: providerAnthropic, EnvVar: "ANTHROPIC_BASE_URL"},
+	{Name: "codex", Provider: providerOpenAI, EnvVar: "OPENAI_BASE_URL"},
+	{Name: "cursor", Provider: providerOpenAI, EnvVar: "OPENAI_BASE_URL"},
+	{Name: "opencode", Provider: providerOpenAI, EnvVar: "OPENAI_BASE_URL"},
+	{Name: "aider", Provider: providerOpenAI, EnvVar: "OPENAI_BASE_URL"},
+}
+
+// core4 is the always-available set (no config needed): it matches the
+// default of config.Wrap.Agents.
+var core4 = map[string]bool{
+	"claude":   true,
+	"codex":    true,
+	"cursor":   true,
+	"opencode": true,
+}
+
+// lookupAgent returns the table entry for name, or nil when the name is not
+// a known agent at all (distinct from "known but not enabled").
+func lookupAgent(name string) *Agent {
+	for i := range agentTable {
+		if agentTable[i].Name == name {
+			return &agentTable[i]
+		}
+	}
+	return nil
+}
+
+// resolveAgent returns the agent to wrap and whether it is enabled.
+// Core-4 agents are always enabled; any other known agent (opt-in: aider,
+// cline, ...) is enabled only when it appears in enabledAgents (the
+// config.Wrap.Agents list). An unknown name is an error with a clear,
+// actionable message — the launcher never guesses.
+func resolveAgent(name string, enabledAgents []string) (*Agent, error) {
+	a := lookupAgent(name)
+	if a == nil {
+		return nil, fmt.Errorf("unknown agent %q (add it to wrap.agents to enable it)", name)
+	}
+	if core4[name] {
+		return a, nil
+	}
+	for _, e := range enabledAgents {
+		if e == name {
+			return a, nil
+		}
+	}
+	return nil, fmt.Errorf("agent %q is not enabled (add it to wrap.agents to enable it)", name)
+}
diff --git a/mnemonic/internal/ctx/wrap/backup.go b/mnemonic/internal/ctx/wrap/backup.go
new file mode 100644
index 00000000..d99e10a4
--- /dev/null
+++ b/mnemonic/internal/ctx/wrap/backup.go
@@ -0,0 +1,96 @@
+package wrap
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// backupPath derives the predictable backup location for an agent:
+// <config file>.ctx-backup when the agent has a config file, otherwise
+// <backup dir>/<agent>.env.bak for env-only agents.
+func backupPath(agent Agent, configPath string) string {
+	if configPath != "" {
+		return configPath + ".ctx-backup"
+	}
+	return filepath.Join(defaultBackupDir, agent.Name+".env.bak")
+}
+
+// defaultBackupDir is the fallback backup location for env-only agents
+// (the launcher's own state dir, not the agent's). ponytail: a single
+// directory per repo root is enough for the core-4; per-machine scoping
+// is an upgrade path if backups ever collide across projects.
+var defaultBackupDir = filepath.Join(".skillgrid", "ctx", "wrap-backups")
+
+// WriteBackup writes the pre-inject state (the config file's current bytes,
+// or a snapshot of the current base-URL env for env-only agents) to
+// backupPath. It runs BEFORE the injection takes effect. Idempotent: if a
+// backup already exists it is left untouched (first wrap only) and
+// (false, nil) is returned so the caller skips re-injection.
+//
+// Returns (false, err) on I/O failure; the caller treats that as
+// fail-open-abort (ADR-0016): no backup, no write, clear error.
+func WriteBackup(agent Agent, configPath string, env func(string) string) (bool, error) {
+	path := backupPath(agent, configPath)
+
+	if _, err := os.Stat(path); err == nil {
+		// Backup exists: already wrapped (or a previous wrap wrote it).
+		return false, nil
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return false, fmt.Errorf("wrap: creating backup dir: %w", err)
+	}
+
+	var content []byte
+	if configPath != "" {
+		// Config-file agents: capture the prior file bytes. A missing file
+		// is the pre-wrap state — the backup records that explicitly so a
+		// restore can recreate (not corrupt) the original.
+		data, err := os.ReadFile(configPath)
+		if err != nil {
+			if os.IsNotExist(err) {
+				content = []byte("<no prior config file>\n")
+			} else {
+				return false, fmt.Errorf("wrap: reading prior config %s: %w", configPath, err)
+			}
+		} else {
+			content = data
+		}
+	} else {
+		// Env-only agents: snapshot the pre-inject base-URL value ("" when
+		// unset) so a restore can put the original value back.
+		content = []byte(agent.EnvVar + "=" + env(agent.EnvVar) + "\n")
+	}
+
+	if err := os.WriteFile(path, content, 0o644); err != nil {
+		return false, fmt.Errorf("wrap: writing backup %s: %w", path, err)
+	}
+	return true, nil
+}
+
+// RestoreBackup puts the pre-wrap state back (inverse of the injection):
+// config-file agents get their original bytes (or the file is removed when
+// none existed); env-only agents get their original env value. It exists so
+// `ctx wrap` is reversible; T14/ops surface the CLI verb.
+func RestoreBackup(agent Agent, configPath string) error {
+	path := backupPath(agent, configPath)
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("wrap: reading backup %s: %w", path, err)
+	}
+	if configPath != "" {
+		if string(content) == "<no prior config file>\n" {
+			if err := os.Remove(configPath); err != nil && !os.IsNotExist(err) {
+				return fmt.Errorf("wrap: removing %s: %w", configPath, err)
+			}
+			return nil
+		}
+		if err := os.WriteFile(configPath, content, 0o644); err != nil {
+			return fmt.Errorf("wrap: restoring %s: %w", configPath, err)
+		}
+		return nil
+	}
+	// Env-only: the restore is a no-op for the process env (the subprocess
+	// gets a fresh env per launch); nothing to undo in-process.
+	return nil
+}
diff --git a/mnemonic/internal/ctx/wrap/config-inject.go b/mnemonic/internal/ctx/wrap/config-inject.go
new file mode 100644
index 00000000..834bf690
--- /dev/null
+++ b/mnemonic/internal/ctx/wrap/config-inject.go
@@ -0,0 +1,82 @@
+package wrap
+
+import "strings"
+
+// configPathFor returns the agent's config-file path, or "" for env-only
+// agents. ponytail: T07 injects via env for all agents (most testable, no
+// per-agent file format to parse); config-file rewriting is an upgrade path
+// for agents that do not honor base-URL env vars, and the backup/inject
+// seam already supports it (backup.go captures prior file bytes when
+// configPath != "").
+func configPathFor(agent Agent) string {
+	return ""
+}
+
+// InjectEnv returns a copy of env with the agent's base-URL var pointed at
+// the proxy. It never mutates the caller's slice.
+func InjectEnv(env []string, agent Agent, proxyBaseURL string) []string {
+	out := make([]string, 0, len(env)+1)
+	replaced := false
+	for _, kv := range env {
+		if strings.HasPrefix(kv, agent.EnvVar+"=") {
+			out = append(out, agent.EnvVar+"="+proxyBaseURL)
+			replaced = true
+			continue
+		}
+		out = append(out, kv)
+	}
+	if !replaced {
+		out = append(out, agent.EnvVar+"="+proxyBaseURL)
+	}
+	return out
+}
+
+// alreadyWrapped reports whether env already targets the CTX loopback proxy
+// (a 127.0.0.1/::1 base URL in the agent's base-URL var) — the idempotency
+// check. A non-loopback base URL (e.g. a real provider endpoint) is NOT
+// "wrapped": the first wrap rewrites it and takes a backup first.
+func alreadyWrapped(env []string, agent Agent) bool {
+	for _, kv := range env {
+		if !strings.HasPrefix(kv, agent.EnvVar+"=") {
+			continue
+		}
+		val := kv[len(agent.EnvVar)+1:]
+		return isLoopbackBaseURL(val)
+	}
+	return false
+}
+
+// isLoopbackBaseURL reports whether base looks like the CTX loopback proxy
+// (a 127.0.0.1 / ::1 / localhost host, with or without a scheme or path).
+// It is a heuristic marker, not a full URL grammar: the launcher only ever
+// writes loopback URLs, so anything else is "not wrapped by us".
+func isLoopbackBaseURL(base string) bool {
+	rest := base
+	if i := strings.Index(rest, "://"); i >= 0 {
+		rest = rest[i+3:]
+	}
+	host := rest
+	// An authority without a path can contain no '/' (it would be the
+	// path separator), so use the first '/' as an "authority ends here"
+	// marker and keep everything after it (a leading path, which we
+	// discard).
+	if i := strings.IndexByte(rest, '/'); i >= 0 {
+		host = rest[:i]
+	}
+	switch {
+	case strings.HasPrefix(host, "["):
+		// Bracketed IPv6 host ([::1]:8787): keep the bracketed address.
+		if i := strings.IndexByte(host, ']'); i >= 0 {
+			host = host[:i+1]
+		}
+	case strings.Contains(host, ":"):
+		// host:port (IPv4/hostname form): drop the port.
+		host = host[:strings.LastIndexByte(host, ':')]
+	}
+	host = strings.Trim(host, "[]")
+	switch host {
+	case "127.0.0.1", "localhost", "::1":
+		return true
+	}
+	return false
+}
diff --git a/mnemonic/internal/ctx/wrap/wrap.go b/mnemonic/internal/ctx/wrap/wrap.go
new file mode 100644
index 00000000..f7c1a2c9
--- /dev/null
+++ b/mnemonic/internal/ctx/wrap/wrap.go
@@ -0,0 +1,300 @@
+package wrap
+
+import (
+	"fmt"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"time"
+
+	ctxconfig "github.com/devopstales/skillgrid/mnemonic/internal/ctx/config"
+	ctxproxy "github.com/devopstales/skillgrid/mnemonic/internal/ctx/proxy"
+)
+
+// Options configures one Wrap run.
+type Options struct {
+	// Cfg is the resolved CTX config (wrap.agents / proxy bind+port).
+	Cfg *ctxconfig.CtxConfig
+	// AgentName is the agent to wrap ("claude", "aider", ...).
+	AgentName string
+	// Binary is the executable to launch as the agent (tests inject a
+	// stub; the CLI resolves the real binary name from the agent table).
+	Binary string
+	// Args are passed after Binary.
+	Args []string
+	// Env is the parent environment for the subprocess (tests inject a
+	// controlled env; the CLI passes os.Environ()).
+	Env []string
+	// BackupDir overrides the default backup dir (tests use t.TempDir()).
+	BackupDir string
+	// Port overrides the proxy port; 0 means "use the configured port
+	// (cfg.Proxy.Port, default 8787)". Tests that need an ephemeral port
+	// pass EphemeralPort.
+	Port int
+	// EphemeralPort forces an ephemeral loopback port (bound as :0)
+	// regardless of Port; the actual port comes back in Result.Port.
+	EphemeralPort bool
+	// Bind is the proxy bind address (default cfg.Proxy.Bind, 127.0.0.1).
+	Bind string
+	// Log receives the launcher's log lines; nil discards them.
+	Log *slog.Logger
+
+	// Stdout/Stderr for the launched agent; nil → os.Stdout/os.Stderr.
+	Stdout io.Writer
+	Stderr io.Writer
+}
+
+// Result is the outcome of a Wrap run.
+type Result struct {
+	// Agent is the resolved agent.
+	Agent Agent
+	// ProxyBaseURL is the loopback base URL the agent was pointed at.
+	ProxyBaseURL string
+	// Port is the port the proxy is serving on (useful for ephemeral).
+	Port int
+	// Injected is true when this run wrote the injection (first wrap);
+	// false on an idempotent re-run (already wrapped).
+	Injected bool
+	// BackedUp is true when this run wrote the backup file (first wrap).
+	BackedUp bool
+	// BackupPath is where the pre-inject state lives ("", if
+	// backup_config is disabled).
+	BackupPath string
+	// Command is the launched subprocess; the caller (or the CLI) waits
+	// on it. Tests use it to capture the subprocess env.
+	Command *exec.Cmd
+}
+
+// StartProxy is a test/CLI seam for launching the proxy server: it is
+// called with the resolved cfg, bind, and port (0 = ephemeral) and must
+// return the serving base URL, the listener's actual address, and a stop
+// func. The default implementation reuses the T04 build: proxy.New +
+// net/http on a loopback listener.
+type StartProxy func(cfg *ctxconfig.CtxConfig, bind string, port int) (baseURL, addr string, stop func(), err error)
+
+// DefaultStartProxy builds and serves the loopback proxy (same build the
+// `ctx proxy` CLI uses: ctxproxy.New + http.Server). With port 0 it binds
+// an ephemeral loopback port and returns the actual address. Telemetry is
+// a no-op (nil store): wrap owns the lifecycle, not the per-turn history
+// (the proxy's own serve path records it when a store is wired).
+func DefaultStartProxy(cfg *ctxconfig.CtxConfig, bind string, port int) (string, string, func(), error) {
+	if bind == "" {
+		bind = cfg.Proxy.Bind
+	}
+	ln, err := net.Listen("tcp", fmt.Sprintf("%s:%d", bind, port))
+	if err != nil {
+		return "", "", nil, fmt.Errorf("wrap: listening on %s:%d: %w", bind, port, err)
+	}
+	mode := ctxproxy.Mode(cfg.Proxy.Mode)
+	log := slog.New(slog.NewTextHandler(io.Discard, nil))
+	p := ctxproxy.New(cfg, nil, log, mode)
+	srv := &http.Server{Handler: p.Handler()}
+	go func() { _ = srv.Serve(ln) }()
+	stop := func() {
+		_ = srv.Close()
+	}
+	addr := ln.Addr().String()
+	base := "http://" + addr
+	return base, addr, stop, nil
+}
+
+// Wrap runs the tier-2 launcher: resolve the agent (core-4 always, others
+// opt-in via cfg.Wrap.Agents), start the proxy, back up the pre-inject
+// state (first wrap only), inject the base-URL env, and launch the agent
+// subprocess. It never modifies the agent's code.
+//
+// Idempotency: if the subprocess env already targets the loopback proxy
+// (alreadyWrapped), the injection and backup are skipped (no double-inject,
+// no double-backup) but the agent still launches.
+//
+// Fail-open (ADR-0016): a proxy-start failure aborts BEFORE launch with a
+// clear error (never point the agent at a dead proxy); a launch failure
+// returns the error from Command.Start (no panic). The proxy is stopped
+// automatically when the returned stopProxy func is called; Wrap returns
+// stopProxy via the result so the caller owns the lifecycle (the CLI keeps
+// it alive for the subprocess lifetime).
+func Wrap(opts Options, startProxy StartProxy) (Result, func(), error) {
+	if opts.Cfg == nil {
+		return Result{}, nil, fmt.Errorf("wrap: nil config")
+	}
+	if opts.AgentName == "" {
+		return Result{}, nil, fmt.Errorf("wrap: agent name required")
+	}
+	if startProxy == nil {
+		startProxy = DefaultStartProxy
+	}
+	log := opts.Log
+	if log == nil {
+		log = slog.New(slog.NewTextHandler(io.Discard, nil))
+	}
+
+	// 1. Resolve the agent: core-4 always; opt-in via cfg.Wrap.Agents.
+	agent, err := resolveAgent(opts.AgentName, opts.Cfg.Wrap.Agents)
+	if err != nil {
+		return Result{}, nil, err
+	}
+	res := Result{Agent: *agent}
+
+	// 2. Start the proxy BEFORE anything else (a dead proxy must never be
+	//    pointed at). Ephemeral port (0) is allowed for tests.
+	bind := opts.Bind
+	if bind == "" {
+		bind = opts.Cfg.Proxy.Bind
+	}
+	port := opts.Cfg.Proxy.Port
+	if opts.Port != 0 {
+		port = opts.Port
+	}
+	if opts.EphemeralPort {
+		port = 0
+	}
+	base, addr, stop, err := startProxy(opts.Cfg, bind, port)
+	if err != nil {
+		if stop != nil {
+			stop()
+		}
+		return Result{}, nil, fmt.Errorf("wrap: starting proxy: %w", err)
+	}
+	res.ProxyBaseURL = base
+	res.Port = portFromAddr(addr)
+
+	// The launcher stops the proxy on any error path from here on; on
+	// success the caller takes ownership via the returned stop func.
+	stopped := false
+	defer func() {
+		if !stopped {
+			stop()
+		}
+	}()
+
+	// Confirm the proxy actually serves (loopback liveness) before the
+	// agent is pointed at it.
+	if err := ping(base); err != nil {
+		return res, nil, fmt.Errorf("wrap: proxy not serving at %s: %w", base, err)
+	}
+
+	// 3. Idempotency: already wrapped? Skip inject + backup, still launch.
+	if alreadyWrapped(opts.Env, *agent) {
+		log.Info("wrap: already wrapped, skipping inject+backup", "agent", agent.Name)
+		res.Injected = false
+		res.BackedUp = false
+		cmd, err := launch(opts, *agent, base)
+		if err != nil {
+			return res, nil, err
+		}
+		res.Command = cmd
+		stopped = true
+		return res, stop, nil
+	}
+
+	// 4. Backup the pre-inject state BEFORE it takes effect (first wrap
+	//    only; a pre-existing backup is left untouched).
+	if opts.Cfg.Wrap.BackupConfig {
+		backedUp, err := writeBackupWithDir(opts, *agent)
+		if err != nil {
+			return res, nil, err
+		}
+		res.BackedUp = backedUp
+		res.BackupPath = backupPath(*agent, configPathFor(*agent))
+		if !backedUp {
+			// A backup already exists from a prior wrap: treat as
+			// already wrapped (no double-inject either).
+			log.Info("wrap: backup exists, skipping inject", "agent", agent.Name)
+			cmd, err := launch(opts, *agent, base)
+			if err != nil {
+				return res, nil, err
+			}
+			res.Command = cmd
+			stopped = true
+			return res, stop, nil
+		}
+	}
+
+	// 5. Inject: the subprocess env gets the base-URL var pointed at the
+	//    proxy (config files are untouched — env injection only, T07).
+	res.Injected = true
+
+	// 6. Launch the agent subprocess with the injected env.
+	cmd, err := launch(opts, *agent, base)
+	if err != nil {
+		return res, nil, err
+	}
+	res.Command = cmd
+	stopped = true
+	return res, stop, nil
+}
+
+// launch builds (and starts) the agent subprocess with the injected env.
+// Fail-open: Start errors are returned, never panicked.
+func launch(opts Options, agent Agent, base string) (*exec.Cmd, error) {
+	binary := opts.Binary
+	if binary == "" {
+		binary = agent.Name
+	}
+	cmd := exec.Command(binary, opts.Args...)
+	cmd.Env = InjectEnv(opts.Env, agent, base)
+	if opts.Stdout != nil {
+		cmd.Stdout = opts.Stdout
+	}
+	if opts.Stderr != nil {
+		cmd.Stderr = opts.Stderr
+	}
+	if err := cmd.Start(); err != nil {
+		return nil, fmt.Errorf("wrap: launching %s: %w", binary, err)
+	}
+	return cmd, nil
+}
+
+// writeBackupWithDir runs the backup with an optional dir override.
+func writeBackupWithDir(opts Options, agent Agent) (bool, error) {
+	if opts.BackupDir == "" {
+		return WriteBackup(agent, configPathFor(agent), envGetter(opts.Env))
+	}
+	// Mkdir the override dir and redirect the default dir for this call.
+	if err := os.MkdirAll(opts.BackupDir, 0o755); err != nil {
+		return false, fmt.Errorf("wrap: creating backup dir %s: %w", opts.BackupDir, err)
+	}
+	prev := defaultBackupDir
+	defaultBackupDir = opts.BackupDir
+	defer func() { defaultBackupDir = prev }()
+	return WriteBackup(agent, configPathFor(agent), envGetter(opts.Env))
+}
+
+// envGetter adapts a []string env to the env func the backup uses.
+func envGetter(env []string) func(string) string {
+	return func(key string) string {
+		prefix := key + "="
+		for _, kv := range env {
+			if len(kv) > len(prefix) && kv[:len(prefix)] == prefix {
+				return kv[len(prefix):]
+			}
+		}
+		return ""
+	}
+}
+
+// ping confirms the proxy answers on loopback (liveness before launch).
+func ping(base string) error {
+	client := &http.Client{Timeout: 2 * time.Second}
+	resp, err := client.Get(base + "/stats")
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	return nil
+}
+
+// portFromAddr extracts the port from a "host:port" address.
+func portFromAddr(addr string) int {
+	_, p, err := net.SplitHostPort(addr)
+	if err != nil {
+		return 0
+	}
+	var port int
+	_, _ = fmt.Sscanf(p, "%d", &port)
+	return port
+}
