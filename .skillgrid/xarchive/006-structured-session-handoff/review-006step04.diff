+	}
+
+	out, code := runSessionCLI(t, blockFile, proj, cwd,
+		"resume", "some-id", "--project", proj, "--dir", blockFile)
+	if code == 0 {
+		t.Fatalf("session resume with no usable store should exit non-zero, got: %s", out)
+	}
+	if !strings.Contains(out, "error") {
