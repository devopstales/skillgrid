 func gitRoot(cwd string) (string, error) {
 	cmd := exec.Command("git", "rev-parse", "--show-toplevel")
 	cmd.Dir = cwd
 	out, err := cmd.Output()
 	if err != nil {
 		return "", err
 	}
 	return strings.TrimSpace(string(out)), nil
 }
diff --git a/skillgrid-cli/internal/mnemonic/mcp/tools_code_additive_test.go b/skillgrid-cli/internal/mnemonic/mcp/tools_code_additive_test.go
