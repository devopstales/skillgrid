+		t.Fatalf("code_communities output not JSON: %v (text %s)", err, text)
+	}
+	if len(out.Communities) < 2 {
+		t.Fatalf("expected >=2 subsystems, got %d (text %s)", len(out.Communities), text)
+	}
+	for _, c := range out.Communities {
