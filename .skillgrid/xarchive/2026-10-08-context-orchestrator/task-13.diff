+	}
+	if len(active) != 0 {
+		t.Errorf("ActiveMemories with nil store = %d rows, want 0", len(active))
+	}
+}
+
+// TestGate_Pre068SchemaFailOpen proves ADR-068 fail-open on a schema that
+// lacks the status column: a row reads as candidate, so ActiveMemories is
+// empty, and Apply is a no-op that does not error (the write is lost, not fatal).
+func TestGate_Pre068SchemaFailOpen(t *testing.T) {
+	shared, err := openRawStore(t, "p-gate-pre068")
+	if err != nil {
+		t.Fatalf("store.Open: %v", err)
+	}
+	t.Cleanup(func() { _ = shared.Close() })
+	// Drop the 068 columns to simulate a store migrated before 068 ran.
+	if _, err := shared.DB.Exec(`ALTER TABLE ctx_traffic_memories DROP COLUMN applied_at`); err != nil {
+		t.Fatalf("drop applied_at: %v", err)
+	}
+	if _, err := shared.DB.Exec(`ALTER TABLE ctx_traffic_memories DROP COLUMN status`); err != nil {
+		t.Fatalf("drop status: %v", err)
+	}
+	cs := ctxstore.New(shared)
+	g := NewGate(cs)
+	seedCandidate(t, cs, "mem-1", "sess-gate", "prefer compact diffs")
+
+	// Pre-068: the row reads as candidate, so it is not active.
+	active, err := g.ActiveMemories("sess-gate")
+	if err != nil {
+		t.Fatalf("ActiveMemories (pre-068): %v", err)
+	}
+	if len(active) != 0 {
+		t.Fatalf("ActiveMemories (pre-068) = %d rows, want 0 (candidate default)", len(active))
+	}
+	// Apply must be a no-op on a schema that cannot persist status (no error).
+	if err := g.Apply("mem-1"); err != nil {
+		t.Errorf("Apply (pre-068) = %v, want nil (fail-open no-op)", err)
+	}
+}
diff --git a/mnemonic/internal/store/migrations/068_ctx_traffic_memory_status.sql b/mnemonic/internal/store/migrations/068_ctx_traffic_memory_status.sql
new file mode 100644
index 00000000..c96dabb5
--- /dev/null
+++ b/mnemonic/internal/store/migrations/068_ctx_traffic_memory_status.sql
@@ -0,0 +1,29 @@
+-- Migration 068: add human-gate status lifecycle to ctx_traffic_memories.
+--
+-- T13 adds a human gate to the traffic learner: the learner only proposes
+-- candidate memories, and ctx learn apply/revoke promotes or demotes them.
+--   status     TEXT NOT NULL DEFAULT 'candidate'
+--                 candidate | applied | revoked. A row stays candidate until a
+--                 human applies it; revocation moves it to revoked so the
+--                 learner stops re-suggesting it.
+--   applied_at INTEGER
+--                 unix millis of the last apply; NULL until first applied.
+--
+-- The CREATE is a no-op on a pre-068 DB (061 already created the table) and is
+-- the authoritative definition for a fresh DB. The two ALTERs add the columns
+-- in place for pre-068 databases; on a fresh DB the CREATE already carried
+-- them, so the ALTERs are the no-op half of the pair.
+CREATE TABLE IF NOT EXISTS ctx_traffic_memories (
+    memory_id    TEXT PRIMARY KEY,
+    session_id   TEXT NOT NULL,
+    category     TEXT NOT NULL,
+    memory_text  TEXT NOT NULL,
+    evidence_json TEXT NOT NULL DEFAULT '{}',
+    confidence   REAL NOT NULL DEFAULT 0,
+    created_at   INTEGER NOT NULL,
+    status       TEXT NOT NULL DEFAULT 'candidate',
+    applied_at   INTEGER
+);
+
+ALTER TABLE ctx_traffic_memories ADD COLUMN status TEXT NOT NULL DEFAULT 'candidate';
+ALTER TABLE ctx_traffic_memories ADD COLUMN applied_at INTEGER;
