+	}
+	if err := g.Revoke("mem-1"); err != nil {
+		t.Fatalf("Revoke #2 (idempotent): %v", err)
+	}
+	if active, _ := g.ActiveMemories("sess-gate"); len(active) != 0 {
+		t.Fatalf("expected 0 active rows after double Revoke, got %d", len(active))
+	}
