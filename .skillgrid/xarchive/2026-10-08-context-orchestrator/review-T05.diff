+// loopback. This replaces the T04 string allow-list (M2).
+func isLoopbackBind(bind string) bool {
+	if bind == "" || bind == "localhost" {
+		return false
+	}
+	// Try to parse as an IP (with or without zone).
+	ip := net.ParseIP(bind)
+	if ip != nil {
+		return ip.IsLoopback()
+	}
