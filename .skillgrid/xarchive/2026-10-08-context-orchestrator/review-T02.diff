+-- 059_ctx_session_summaries.sql — CTX (ADR-0033/0012) per-session summary.
+-- One row per finished proxied session carrying the wide event counters
+-- (judgment, prefilter, shaping, effort routing) and the full wide event
+-- JSON. Schema verbatim from the context-orchestrator plan §9.3
+-- (TICKET-02 / TASK-091).
+CREATE TABLE IF NOT EXISTS ctx_session_summaries (
+    session_id            TEXT PRIMARY KEY,
+    agent                 TEXT,
+    duration_ms           INTEGER,
+    turns                 INTEGER,
+    tokens_saved          INTEGER,
+    judgment_keeps        INTEGER,
+    judgment_truncs       INTEGER,
+    prefilter_pins        INTEGER,
+    prefilter_deads       INTEGER,
+    cache_invalidations   INTEGER,
+    shaping_applied       BOOLEAN,
+    effort_routed         INTEGER,
+    traffic_memories      INTEGER,
+    summary_json          TEXT,     -- the full wide event
+    created_at            INTEGER
+);
diff --git a/mnemonic/internal/store/migrations/060_ctx_stats_history.sql b/mnemonic/internal/store/migrations/060_ctx_stats_history.sql
new file mode 100644
index 00000000..b0890b4a
--- /dev/null
+++ b/mnemonic/internal/store/migrations/060_ctx_stats_history.sql
@@ -0,0 +1,15 @@
+-- 060_ctx_stats_history.sql — CTX (ADR-0033/0012) aggregated stats history.
+-- One row per (granularity, bucket) rollup; the store-level Rollup query
+-- re-aggregates these into tokens_saved/requests/sessions/cache_hits grouped
+-- by granularity + bucket. Schema verbatim from the context-orchestrator
+-- plan §9.3 (TICKET-02 / TASK-091).
+CREATE TABLE IF NOT EXISTS ctx_stats_history (
+    bucket_id             TEXT PRIMARY KEY,
