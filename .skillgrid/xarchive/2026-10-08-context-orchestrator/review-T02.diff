+		if err := rows.Scan(&p.SavingID, &p.SessionID, &p.Turn, &p.Upstream, &p.Mode,
+			&p.TokensBefore, &p.TokensAfter, &p.SavingsRatio, &p.CreatedAt); err != nil {
