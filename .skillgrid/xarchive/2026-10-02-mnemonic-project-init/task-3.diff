+func TestInitIndexesTheProject(t *testing.T) {
+	data := t.TempDir()
+	svc := service.New(data)
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "a.go"), []byte("package a\nfunc F() {}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	res, err := projectInit(context.Background(), svc, dir, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
