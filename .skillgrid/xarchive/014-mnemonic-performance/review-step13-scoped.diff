+// mustExec is a tiny Exec helper for the tier persistence checks.
+func mustExec(t *testing.T, fx *ownerFixture, query string, args ...any) {
+	t.Helper()
+	if _, err := fx.st.DB.Exec(query, args...); err != nil {
+		t.Fatalf("exec %q: %v", query, err)
+	}
+}
