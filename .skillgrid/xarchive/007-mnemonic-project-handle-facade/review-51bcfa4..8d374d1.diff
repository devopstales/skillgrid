 		return nil, fmt.Errorf("invalid project id %q", projectID)
 	}
 	if err := os.MkdirAll(dataDir, 0o755); err != nil {
 		return nil, fmt.Errorf("create data dir: %w", err)
 	}
 	dbPath := filepath.Join(dataDir, projectID+".sqlite")
