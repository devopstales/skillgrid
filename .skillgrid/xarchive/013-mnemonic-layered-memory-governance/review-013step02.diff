+	res, err := Distill(ctx, fx.svc, fx.sessionID, DistillOptions{})
+	if err != nil {
+		t.Fatalf("distill: %v", err)
+	}
+	if res.Created {
+		t.Fatalf("no L1-able content must be a no-op, got created=%v", res.Created)
+	}
