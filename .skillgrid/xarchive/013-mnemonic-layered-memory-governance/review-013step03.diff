+	if len(res2.Hits[0].Content) <= len(inListContent) {
+		t.Fatalf("tuned (larger) char cap must keep more in-list content: tuned %d <= default %d", len(res2.Hits[0].Content), len(inListContent))
+	}
+	_ = svc2
+}
