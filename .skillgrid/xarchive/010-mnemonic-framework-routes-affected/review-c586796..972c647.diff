+var routeCfg = Config{
+	Include:      []string{"**/*.go", "**/*.js", "**/*.ts", "**/*.tsx", "**/*.py", "**/*.rb", "**/*.java", "**/*.svelte"},
+	Exclude:      []string{"**/node_modules/**", "**/.git/**"},
+	ChunkLines:   80,
+	ChunkOverlap: 10,
+}
