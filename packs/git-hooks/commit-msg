#!/bin/sh
# aiskillgrid-managed: commit-msg
# Strips AI/agent co-author trailers, then runs any previous commit-msg hook.
#
# Installed by `aiskillgrid install` into .git/hooks/commit-msg
# Do not edit between skillgrid:managed markers — reinstall refreshes this block.

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
	exit 0
fi

# skillgrid:managed:start
# Remove AI / agent attribution trailers and common "generated by" lines.
TMP_FILE="${MSG_FILE}.aiskillgrid.tmp"
# Portable sed: delete matching lines (case-insensitive where supported).
if sed --version >/dev/null 2>&1; then
	# GNU sed
	sed -E \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]]*Cursor[[:space:]]*</Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]ursor[Aa]gent@/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]laude/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]opilot/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]hat[Gg][Pp][Tt]/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Oo]pen[Aa][Ii]/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Gg]emini/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Dd]evin/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]odex/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*noreply\.github\.com.*[Bb]ot/Id' \
		-e '/^[[:space:]]*Signed-off-by:[[:space:]].*[Cc]ursor/Id' \
		-e '/^[[:space:]]*Signed-off-by:[[:space:]].*[Cc]laude/Id' \
		-e '/^[[:space:]]*Generated-by:[[:space:]]*/Id' \
		-e '/^[[:space:]]*Generated by Cursor/Id' \
		-e '/^[[:space:]]*Co-authored with AI/Id' \
		"$MSG_FILE" >"$TMP_FILE" && mv "$TMP_FILE" "$MSG_FILE"
else
	# BSD sed (macOS): no -i portability issues when writing to temp
	sed -E \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]]*Cursor[[:space:]]*</Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]ursor[Aa]gent@/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]laude/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]opilot/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]hat[Gg][Pp][Tt]/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Oo]pen[Aa][Ii]/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Gg]emini/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Dd]evin/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*[Cc]odex/Id' \
		-e '/^[[:space:]]*Co-authored-by:[[:space:]].*noreply\.github\.com.*[Bb]ot/Id' \
		-e '/^[[:space:]]*Signed-off-by:[[:space:]].*[Cc]ursor/Id' \
		-e '/^[[:space:]]*Signed-off-by:[[:space:]].*[Cc]laude/Id' \
		-e '/^[[:space:]]*Generated-by:[[:space:]]*/Id' \
		-e '/^[[:space:]]*Generated by Cursor/Id' \
		-e '/^[[:space:]]*Co-authored with AI/Id' \
		"$MSG_FILE" >"$TMP_FILE" && mv "$TMP_FILE" "$MSG_FILE"
fi
rm -f "$TMP_FILE"
# skillgrid:managed:end

# Chain previous project hook (preserved on first Skillgrid install).
HOOK_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
PREV="$HOOK_DIR/commit-msg.aiskillgrid-prev"
if [ -x "$PREV" ]; then
	exec "$PREV" "$@"
fi
exit 0
